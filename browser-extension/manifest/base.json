{
  "manifest_version": 3,
  "name": "Inkspect",
  "description": "A toolbar for working with AI agents (element details, screenshots, drawing, responsive view), and live two-way bookmark sync with VS Code.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Inkspect",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "toggle-toolbar": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Show or hide the Inkspect toolbar"
    }
  },
  "permissions": [
    "storage",
    "bookmarks",
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "web_accessible_resources": [
    { "resources": ["codicon.ttf", "icons/32.png"], "matches": ["<all_urls>"] }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
