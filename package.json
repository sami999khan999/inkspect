{
  "name": "inkspect",
  "private": true,
  "description": "Inkspect: a browser inside VS Code and a browser extension (Chrome, Edge, Brave, Firefox), with tools for giving AI agents context.",
  "workspaces": [
    "shared",
    "vscode-extension",
    "browser-extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w vscode-extension",
    "test:e2e:browser": "npm run test:e2e -w browser-extension",
    "package": "npm run package -w vscode-extension",
    "format": "prettier --write .",
    "logo": "node brand/render.mjs"
  }
}
