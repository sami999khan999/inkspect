{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "path": "vscode-extension",
      "label": "npm: build - vscode-extension",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "vscode-extension",
      "label": "npm: watch - vscode-extension",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vscode-browser",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "\[watch\] build started",
          "endsPattern": "\[watch\] build finished"
        }
      }
    }
  ]
}
