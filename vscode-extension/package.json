      "explorer/context": [
        {
          "command": "vscodeBrowser.openFile",
          "when": "resourceScheme == file && resourceExtname =~ /^.(html?|svg|pdf)$/i",
          "group": "navigation@90"
        }
      ],
      "editor/title": [
        {
          "command": "vscodeBrowser.openFile",
          "when": "resourceScheme == file && resourceExtname =~ /^.html?$/i",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "vscodeBrowser.openFile",
          "when": "resourceScheme == file && resourceExtname =~ /^.(html?|svg|pdf)$/i",
          "group": "1_open"
        }
      ],
      "view/title": [
        {
          "command": "vscodeBrowser.newWindow",
          "when": "view == vscodeBrowser.tabs",
          "group": "navigation"
        },
        {
          "command": "vscodeBrowser.bookmarkPage",
          "when": "view == vscodeBrowser.bookmarks",
          "group": "navigation@1"
        },
        {
          "command": "vscodeBrowser.newBookmarkFolder",
          "when": "view == vscodeBrowser.bookmarks",
          "group": "navigation@2"
        },
        {
          "command": "vscodeBrowser.showBookmarks",
          "when": "view == vscodeBrowser.bookmarks",
          "group": "navigation@3"
        },
        {
          "command": "vscodeBrowser.importBookmarks",
          "when": "view == vscodeBrowser.bookmarks",
          "group": "2_io"
        },
        {
          "command": "vscodeBrowser.exportBookmarks",
          "when": "view == vscodeBrowser.bookmarks",
          "group": "2_io"
        },
        {
          "command": "vscodeBrowser.openSettings",
          "when": "view == vscodeBrowser.actions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscodeBrowser.closeTabById",
          "when": "view == vscodeBrowser.tabs && viewItem == browserTab",
          "group": "inline"
        },
        {
          "command": "vscodeBrowser.removeBookmark",
          "when": "view == vscodeBrowser.bookmarks && viewItem =~ /^(bookmark|bookmarkFolder)$/",
          "group": "inline"
        },
        {
          "command": "vscodeBrowser.renameBookmark",
          "when": "view == vscodeBrowser.bookmarks && viewItem =~ /^(bookmark|bookmarkFolder)$/",
          "group": "1_edit"
        },
        {
          "command": "vscodeBrowser.newBookmarkFolder",
          "when": "view == vscodeBrowser.bookmarks && viewItem =~ /^(bookmarkRoot|bookmarkFolder)$/",
          "group": "1_edit"
        },
        {
          "command": "vscodeBrowser.removeBookmark",
          "when": "view == vscodeBrowser.bookmarks && viewItem =~ /^(bookmark|bookmarkFolder)$/",
          "group": "2_remove"
        }
      ]
