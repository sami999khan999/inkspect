{
  "name": "vscode-browser",
  "displayName": "VS Code Browser",
  "description": "A full web browser inside VS Code with an element picker, drawing, screenshots, device emulation and Chrome extension support, built for giving AI agents context.",
  "version": "0.0.1",
  "publisher": "your-publisher",
  "private": true,
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other",
    "Testing",
    "Debuggers",
    "AI"
  ],
  "keywords": [
    "ai",
    "annotate",
    "browser",
    "chrome extensions",
    "chromium",
    "devtools",
    "inspector",
    "mcp",
    "preview",
    "responsive",
    "screenshot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:vscodeBrowser.browser"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodeBrowser.open",
        "title": "Open",
        "category": "Browser",
        "icon": "$(globe)"
      },
      {
        "command": "vscodeBrowser.newWindow",
        "title": "New Window",
        "category": "Browser",
        "icon": "$(add)"
      },
      {
