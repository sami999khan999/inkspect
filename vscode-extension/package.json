      }
    ],
    "languageModelTools": [
      {
        "name": "browser_navigate",
        "displayName": "Open a URL in the browser",
        "toolReferenceName": "browserNavigate",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Open a URL in the browser",
        "modelDescription": "Opens a URL in the active tab of the VS Code Browser (a Chromium browser inside VS Code) and waits for it to load. Use it to show or check a web page, for example a local dev server such as http://localhost:3000. Returns the final URL and page title.",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL to open. http, https and file URLs; a missing scheme means https (http for localhost)."
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "browser_screenshot",
        "displayName": "Screenshot the browser page",
        "toolReferenceName": "browserScreenshot",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Screenshot the browser page",
        "modelDescription": "Takes a screenshot of the page in the VS Code Browser and saves it as an image file. Captures the visible viewport by default, the whole page with mode \"fullPage\", or one element with a CSS selector. Returns the file path (and the image, where supported).",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "viewport",
                "fullPage"
              ],
              "description": "What to capture when no selector is given. Default: viewport."
            },
            "selector": {
              "type": "string",
              "description": "CSS selector of an element to capture instead (the first match)."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "browser_get_element",
        "displayName": "Get element details",
        "toolReferenceName": "browserGetElement",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get element details",
        "modelDescription": "Returns details of the first element matching a CSS selector on the page in the VS Code Browser: a unique selector, XPath, role and accessible name, size and position, key computed styles, the UI framework component and its source file when detectable, and trimmed HTML.",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string",
              "description": "CSS selector, e.g. \"form#login button\"."
            }
          },
          "required": [
            "selector"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "browser_get_selection",
        "displayName": "Get the element the user picked",
        "toolReferenceName": "browserGetSelection",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get the element the user picked",
        "modelDescription": "Returns the element(s) the user last picked with the element selector cursor of the VS Code Browser, as Markdown details. Use it when the user refers to \"this element\" or \"the element I selected\".",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "browser_console_errors",
        "displayName": "Get console errors",
        "toolReferenceName": "browserConsoleErrors",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get console errors",
        "modelDescription": "Returns console errors, warnings and uncaught exceptions of the page in the VS Code Browser since it was loaded, with source locations (workspace paths when they map to workspace files).",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "browser_failed_requests",
        "displayName": "Get failed network requests",
        "toolReferenceName": "browserFailedRequests",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get failed network requests",
        "modelDescription": "Returns network requests of the page in the VS Code Browser that failed or returned HTTP 400 or above. Requests are recorded from the first call on (or from when the developer drawer was opened), so reload the page after the first call to see requests made while loading.",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "browser_page_context",
        "displayName": "Get page context",
        "toolReferenceName": "browserPageContext",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get page context",
        "modelDescription": "Returns a summary of the page in the VS Code Browser: URL, title, viewport or emulated device, the text the user selected, recent console errors and failed requests.",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "browser_get_page_text",
        "displayName": "Get page text",
        "toolReferenceName": "browserGetPageText",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "userDescription": "Get page text",
        "modelDescription": "Returns the visible text of the page in the VS Code Browser (document.body.innerText), with its URL and title. Long pages are truncated.",
        "tags": [
          "browser"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "maxLength": {
              "type": "number",
              "description": "Maximum number of characters to return. Default 20000."
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with VS Code Browser",
        "description": "Browse, inspect elements for AI agents, draw, take screenshots and test any resolution without leaving VS Code.",
        "steps": [
          {
            "id": "open",
            "title": "Open the browser",
            "description": "A full Chromium browser in an editor tab.\n[Open Browser](command:vscodeBrowser.open)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.open"
            ]
          },
          {
            "id": "inspect",
            "title": "Pick an element for your agent",
            "description": "Hover to see details; click to copy them for an AI agent.\n[Start Element Selector](command:vscodeBrowser.toggleInspector)",
            "media": {
              "markdown": "media/walkthrough/inspect.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.toggleInspector"
            ]
          },
          {
            "id": "draw",
            "title": "Draw and take screenshots",
            "description": "Mark up the page, then capture just the part you drew on.\n[Start Drawing](command:vscodeBrowser.toggleDrawing)",
            "media": {
              "markdown": "media/walkthrough/draw.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.toggleDrawing",
              "onCommand:vscodeBrowser.screenshot.annotations"
            ]
          },
          {
            "id": "devices",
            "title": "Test at any resolution",
            "description": "Phones, tablets, 4K or any size, with touch and throttling.\n[Open Device Toolbar](command:vscodeBrowser.toggleDeviceToolbar)",
            "media": {
              "markdown": "media/walkthrough/devices.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.toggleDeviceToolbar",
              "onCommand:vscodeBrowser.emulateDevice"
            ]
          },
          {
            "id": "extensions",
            "title": "Add browser extensions",
            "description": "Install from the Chrome Web Store, a file, or an unpacked folder.\n[Manage Extensions](command:vscodeBrowser.extensions.manage)",
            "media": {
              "markdown": "media/walkthrough/extensions.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.extensions.manage",
              "onCommand:vscodeBrowser.extensions.installWebStore"
            ]
          },
          {
            "id": "agents",
            "title": "Let agents use the browser",
            "description": "Chat agents can open pages, take screenshots and read elements and errors.\n[Send Page Context to Chat](command:vscodeBrowser.sendPageContextToChat)",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            },
            "completionEvents": [
              "onCommand:vscodeBrowser.sendPageContextToChat",
              "onCommand:vscodeBrowser.mcp.copyConfig"
            ]
          }
        ]
      }
    ]
