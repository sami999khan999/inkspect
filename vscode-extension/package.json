  "scripts": {
    "build": "run-p build:ext build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview/vite.config.mts --mode development",
    "build:prod": "node esbuild.mjs --production && vite build --config webview/vite.config.mts --mode production",
    "watch": "run-p watch:ext watch:webview",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch --mode development",
    "typecheck": "tsc -p . && tsc -p webview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build:prod",
    "package": "vsce package --no-dependencies",
    "test:e2e": "npm run build && node test/e2e/runTests.mjs",
    "sync:tools": "node scripts/sync-tools.mjs"
  },
  "dependencies": {
    "@inkspect/shared": "*",
    "@puppeteer/browsers": "^3.2.3",
    "@vscode/codicons": "0.0.46-24",
    "fflate": "^0.8.3",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.101.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "devtools-protocol": "^0.0.1687809",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "extensionKind": [
    "ui",
    "workspace"
