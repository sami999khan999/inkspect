    "configuration": {
      "title": "VS Code Browser",
      "properties": {
        "vscodeBrowser.homepage": {
          "type": "string",
          "default": "vb://newtab",
          "markdownDescription": "Page opened by the Home button. Use `vb://newtab` for the new tab page."
        },
        "vscodeBrowser.searchEngine": {
          "type": "string",
          "enum": [
            "google",
            "bing",
            "duckduckgo",
            "custom"
          ],
          "default": "google",
          "description": "Search engine used for address bar input that is not a URL."
        },
        "vscodeBrowser.searchEngineUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Search URL for the `custom` search engine. `%s` is replaced by the search terms, e.g. `https://kagi.com/search?q=%s`."
        },
        "vscodeBrowser.chromium.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a Chromium-based browser to use instead of the downloaded Chrome for Testing. Note that branded Google Chrome does not allow loading extensions."
        },
        "vscodeBrowser.chromium.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line switches passed to Chromium. Takes effect after restarting the browser engine."
        },
        "vscodeBrowser.render.jpegQuality": {
          "type": "number",
          "default": 85,
          "minimum": 30,
          "maximum": 100,
          "description": "JPEG quality of the page image streamed into VS Code. Higher is sharper but uses more CPU."
        },
        "vscodeBrowser.tabs.maxLive": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of tabs per window that keep their page loaded. Older background tabs are unloaded and reload when you switch to them."
        },
        "vscodeBrowser.downloads.directory": {
          "type": "string",
          "default": "",
          "description": "Folder for downloads. Defaults to your Downloads folder."
        },
        "vscodeBrowser.ignoreLocalhostCertificateErrors": {
          "type": "boolean",
          "default": false,
          "description": "Accept invalid (e.g. self-signed) HTTPS certificates on localhost. Takes effect after restarting the browser engine."
        },
        "vscodeBrowser.openLinksFromTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Make localhost URLs in the terminal open in the VS Code browser."
        },
        "vscodeBrowser.liveReloadFiles": {
          "type": "boolean",
          "default": true,
          "description": "Reload tabs showing a local file when that file is saved."
        },
        "vscodeBrowser.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar button that opens the browser."
        },
        "vscodeBrowser.debug.logCdp": {
          "type": "boolean",
          "default": false,
          "description": "Log every Chrome DevTools Protocol command to the output channel (trace level)."
        },
        "vscodeBrowser.showBookmarksBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the bookmarks bar under the address bar (when it has bookmarks)."
        },
        "vscodeBrowser.session.restore": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "default": "always",
          "enumDescriptions": [
            "Reopen the tabs of browser windows that were open when VS Code closed.",
            "Restored browser windows start with a new tab page."
          ],
          "description": "What to do with open browser tabs when VS Code restarts or reloads."
        },
        "vscodeBrowser.devices.custom": {
          "type": "array",
          "default": [],
          "markdownDescription": "Your own device presets for the device toolbar. Save one from the toolbar, or add entries like `{ \"name\": \"Kiosk\", \"width\": 1080, \"height\": 1920, \"dpr\": 1, \"mobile\": false, \"touch\": true, \"userAgent\": \"desktop\" }`.",
          "items": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "minimum": 50
              },
              "height": {
                "type": "number",
                "minimum": 50
              },
              "dpr": {
                "type": "number",
                "default": 1
              },
              "mobile": {
                "type": "boolean",
                "default": false
              },
              "touch": {
                "type": "boolean",
                "default": false
              },
              "userAgent": {
                "type": "string",
                "enum": [
                  "desktop",
                  "android",
                  "iphone",
                  "ipad"
                ],
                "default": "desktop"
              }
            }
          }
        },
        "vscodeBrowser.screenshots.directory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for screenshots. Relative paths are inside the workspace. Default: `.vscode-browser/screenshots` in the workspace (or the extension storage without a workspace)."
        },
        "vscodeBrowser.screenshots.format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ],
          "default": "png",
          "description": "Image format of screenshots."
        },
        "vscodeBrowser.screenshots.defaultAction": {
          "type": "string",
          "enum": [
            "saveAndCopy",
            "save",
            "copy",
            "ask"
          ],
          "default": "saveAndCopy",
          "enumDescriptions": [
            "Save the file and copy the image to the clipboard.",
            "Save the file and copy its path (handy for AI agents that read files).",
            "Only copy the image to the clipboard.",
            "Ask every time."
          ],
          "description": "What happens with a new screenshot."
        },
        "vscodeBrowser.screenshots.annotationPadding": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "maximum": 500,
          "description": "Space (in CSS pixels) kept around drawings when capturing the drawing area."
        },
        "vscodeBrowser.inspector.copyFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "json",
            "selector",
            "html"
          ],
          "default": "markdown",
          "description": "Format of element details copied with the element picker."
        },
        "vscodeBrowser.inspector.fields": {
          "type": "array",
          "default": [
            "page",
            "selector",
            "xpath",
            "role",
            "component",
            "box",
            "text",
            "styles",
            "attributes",
            "html"
          ],
          "items": {
            "type": "string",
            "enum": [
              "page",
              "selector",
              "xpath",
              "role",
              "component",
              "box",
              "text",
              "styles",
              "attributes",
              "html"
            ]
          },
          "description": "Which details the element picker copies (Markdown and JSON formats)."
        },
        "vscodeBrowser.inspector.maxHtmlLength": {
          "type": "number",
          "default": 1500,
          "minimum": 100,
          "description": "Longest HTML snippet to copy. Longer elements are copied with their children collapsed."
        },
        "vscodeBrowser.inspector.writeSelectionFile": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also write the last picked element(s) to `.vscode-browser/context/selection.md` in the workspace, so AI agents can read it."
        },
        "vscodeBrowser.drawing.clearOnNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Remove drawings when the tab navigates to another page."
        },
        "vscodeBrowser.devtools.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open a local debugging port (random, 127.0.0.1 only) so **Open DevTools** can show Chrome DevTools. Other programs on this computer could connect to it too; turn it off if that matters. Takes effect after restarting the browser engine."
        },
        "vscodeBrowser.agent.confirmNavigation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before an agent in VS Code chat opens a page in the browser (the `browser_navigate` tool). MCP clients ask for approval themselves."
        },
        "vscodeBrowser.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Serve the browser tools as an MCP server on 127.0.0.1 for agents outside VS Code (for example CLI agents). Requests need a token; use **Browser: Copy MCP Server Configuration** to set up a client. Agents in VS Code chat use the built-in tools and do not need this."
        },
        "vscodeBrowser.mcp.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "Port of the MCP server. `0` picks a free port once and keeps it."
        },
        "vscodeBrowser.bridge.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let the **Inkspect browser extension** (Chrome, Edge, Brave, Firefox) link to VS Code on `127.0.0.1` to sync bookmarks and send screenshots and element details to chat or a terminal agent. Browsers must be paired once with **Browser: Connect Browser Extension**."
        },
        "vscodeBrowser.bridge.port": {
          "type": "number",
          "default": 47110,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Port of the browser link. The extension tries this port and the next four."
        },
        "vscodeBrowser.bridge.syncBookmarks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Sync bookmarks both ways with linked browsers."
        }
      }
    },
