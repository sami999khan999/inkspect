{
  "manifest_version": 3,
  "name": "Hello Fixture",
  "version": "1.0.0",
  "description": "Test extension with a content script, a popup and a service worker.",
  "action": { "default_popup": "popup.html", "default_title": "Hello" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage"]
}
